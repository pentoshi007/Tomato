# Tomato frontend environment
# Copy to .env and fill in your values.

# Backend microservice URLs (Render deployments)
VITE_AUTH_SERVICE_URL=https://your-auth.onrender.com
VITE_RESTAURANT_SERVICE_URL=https://your-restaurant.onrender.com
VITE_UTILS_SERVICE_URL=https://your-utils.onrender.com
VITE_RIDER_SERVICE_URL=https://your-rider.onrender.com
VITE_ADMIN_SERVICE_URL=https://your-admin.onrender.com
VITE_REALTIME_SERVICE_URL=https://your-realtime.onrender.com

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Internal service key shared with the realtime service
VITE_INTERNAL_SERVICE_KEY=your-internal-key

# Maps (OpenStreetMap / Leaflet)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ROUTING_URL=https://router.project-osrm.org/route/v1
VITE_OPENSTREETMAP_COPYRIGHT_URL=https://www.openstreetmap.org/copyright
VITE_LEAFLET_ICON_RETINA_URL=https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png
VITE_LEAFLET_ICON_URL=https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png
VITE_LEAFLET_ICON_SHADOW_URL=https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png
